  "research": [
    {
      "feedback": ["VR-048", "VR-049", "VR-051", "VR-052"],
      "source": "NEN - Achtergrond conditiemeting",
      "url": "https://www.nen.nl/bouw/beheer-en-onderhoud/conditiemeting/achtergrond-conditiemeting",
      "finding": "NEN describes a six-point condition result derived from severity, extent and intensity, organized by building parts. Condition is distinct from risk and business policy.",
      "decision": "Keep an optional 1-6 criterion scale with explicit customer definitions and per-criterion outcome mapping. Store repair and cost responsibility separately as customer policy. Do not label the implementation NEN compliant or copy a proprietary defects library."
    },
    {
      "feedback": ["VR-024", "VR-025", "VR-026"],
      "source": "RICS - Home Survey sample reports",
      "url": "https://www.rics.org/profession-standards/rics-standards-and-guidance/sector-standards/building-surveying-standards/home-surveys",
      "sample": "https://www.rics.org/content/dam/ricsglobal/documents/standards/Sample-Home-Survey-Level-3-Report.pdf",
      "finding": "Primary sample reports provide a structured survey reference with condition-led sections. RICS report products require a licence.",
      "decision": "Use an original Satvey format: concise overview, room hierarchy, confirmed findings, visible supporting photographs and action responsibilities. Do not copy RICS wording, branding or claim RICS compliance."
    },
    {
      "feedback": ["VR-024", "VR-025", "VR-026"],
      "source": "UK Department for Education - condition survey report guidance",
      "url": "https://www.gov.uk/government/publications/commissioning-a-condition-survey-for-school-and-college-buildings/condition-surveys-for-school-and-college-buildings-guidance-for-responsible-bodies",
      "finding": "Reports should combine a clear summary, condition assessment, priority/actions and supporting photographs.",
      "decision": "Present a short overview before detailed evidence and show photos beside the associated findings rather than relying solely on an appendix."
    },
    {
      "feedback": ["VR-016", "VR-025", "VR-052"],
      "source": "ConditionHQ - product workflow",
      "url": "https://conditionhq.app/",
      "finding": "The vendor organizes property inspections by rooms and items and connects notes, ratings and photos to each item, with progress and report review. These are vendor claims, not an independent product test.",
      "decision": "Retain room identity for capture/audio/evidence and quiet element identifiers for reusable criteria and analytics. Inspectors do not need an extra element-selection task while walking. Administration remains in the catalog and framework editor."
    }
  ],
