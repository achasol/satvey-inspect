# Copy to .env.production at the repository root; protect it with chmod 600.
APP_URL=https://inspect.example.org
APP_DOMAIN=inspect.example.org
ACME_EMAIL=operations@example.org
# Resolve verified images to repository@sha256:digest references before deployment.
WEB_IMAGE=
API_IMAGE=
CADDY_IMAGE=
POSTGRES_IMAGE=
RUSTFS_IMAGE=
PDF_IMAGE=
POSTGRES_PASSWORD=
# URL-encode the database password in this URL.
DATABASE_URL=postgres://satvey:REPLACE@postgres:5432/satvey?sslmode=disable
S3_BUCKET=satvey-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=
APP_ENCRYPTION_KEY=
PROPERTY_ENCRYPTION_KEY=
BASETEN_KEY=
SMTP_ADDR=smtp.example.org:587
SMTP_TLS=starttls
SMTP_FROM=inspect@example.org
SMTP_USERNAME=
SMTP_PASSWORD=
# Exact hosts for issuers, authorization/token/JWKS URLs and VERA endpoints.
INTEGRATION_ALLOWED_HOSTS=
# Explicit subset allowed to resolve to private addresses; empty by default.
INTEGRATION_PRIVATE_HOSTS=

# Public app support, privacy and store metadata. Use real operator details.
LEGAL_ENTITY=
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
HOSTING_REGION=
REPORT_ATTACHMENT_MAX_MB=10
