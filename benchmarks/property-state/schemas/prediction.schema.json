{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "findings"],
  "properties": {
    "caseId": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "description", "faultType", "component", "photoIds"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "description": {"type": "string", "minLength": 1, "maxLength": 6000},
          "faultType": {"type": "string"},
          "component": {"type": "string"},
          "photoIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
