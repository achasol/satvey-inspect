APP_URL=http://localhost:5173
POSTGRES_PASSWORD=satvey-local-db
S3_ACCESS_KEY=satvey-local
S3_SECRET_KEY=satvey-local-secret-change-me
# Only enable plain HTTP OIDC for local development.
ALLOW_HTTP_OIDC=true
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-change-me
RUSTFS_CONSOLE_PORT=19001
# auto uses Baseten when a key is present, otherwise explicit example proposals.
BASETEN_KEY=
BASETEN_MODEL=zai-org/GLM-5.3-Flash
IMAGE_ANALYSIS_PROVIDER=auto
# Shared hosted audio model only; auto uses the same server-side Baseten key.
TRANSCRIPTION_PROVIDER=auto
# Local browser tests request mock processing so tests do not spend API credits.
ALLOW_MOCK_ANALYSIS=true
# Required only for VERA credentials. Generate once: openssl rand -base64 32
PROPERTY_ENCRYPTION_KEY=
# Plain HTTP property APIs are only intended for an isolated local test server.
ALLOW_HTTP_PROPERTY_API=false
