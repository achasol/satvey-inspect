{
  "name": "@satvey/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node --max-old-space-size=768 ../../node_modules/typescript/bin/tsc -b && node --max-old-space-size=768 ../../node_modules/vite/bin/vite.js build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --max-old-space-size=512 ../../node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --max-old-space-size=512 ../../node_modules/vitest/vitest.mjs run --coverage",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
