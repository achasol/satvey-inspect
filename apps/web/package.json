    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "lucide-react": "1.23.0",
    "radix-ui": "1.8.1",
    "react": "19.2.7",
